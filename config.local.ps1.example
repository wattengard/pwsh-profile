# Local overrides for config.ps1.
#
# Copy this file to config.local.ps1 and keep only the lines you want to change. Git ignores
# config.local.ps1, so pulling never touches it, and anything you leave out follows the defaults
# in config.ps1 (which also lists every setting with its allowed values).
#
# Keep to one form, one setting per line:
#     $env:NAME = 'value'
# A trailing comment is fine. You can also skip editing by hand: `cfg` (Edit-ProfileConfig) opens
# an interactive settings screen and `Set-ProfileConfig NAME VALUE` changes one setting. Both read
# and write exactly these lines and leave everything else, comments and other code, as it is.

#$env:PROFILE_UPDATE_CHECK = '0'            # 1 (default) = check GitHub in the background for a newer profile, 0 = never
#$env:PROFILE_BANNER = '0'                  # 1 (default) = show the startup banner, 0 = hide it
#$env:PROFILE_CONTAINER_RUNTIME = 'podman'  # docker (default) or podman: the runtime dhs puts in the run command
#$env:PROFILE_ICONS = 'plain'               # nerd (default) or plain
#$env:PROMPT_GIT_MESSAGE_WIDTH = '100'       # characters of the commit subject
#$env:PROFILE_RG_ALLOW_USERS = '1'          # 1 = let rg and rgf search under C:\Users (OneDrive may download files)
#$env:PROFILE_TELLME_MODEL = 'haiku'         # sonnet (default), haiku or opus: the model tellme asks
#$env:PROFILE_TELLME_EFFORT = 'medium'      # low (default), medium or high: how hard tellme thinks
#$env:PROMPT_GIT_STATE = '0'                # 1 = show working tree state, 0 = hide it
